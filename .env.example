# ============================================================
# Muhammad Hassan Portfolio CMS - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit your production .env with secret keys to public Git!
# ============================================================

FLASK_APP=app.py
FLASK_ENV=production

# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-key-before-deploying

# Database path (automatically resolved to portfolio.db in project root)
DATABASE_URL=sqlite:///portfolio.db

# Admin Contact Email (Where messages from the contact form are delivered)
CONTACT_RECIPIENT_EMAIL=mhassanawan66521@gmail.com

# Admin Registration Allow-List (Only this email can register as admin)
ALLOWED_ADMIN_EMAILS=mhassanawan66521@gmail.com

# ------------------------------------------------------------
# 1. RESEND API (RECOMMENDED FOR PYTHONANYWHERE FREE TIER)
# ------------------------------------------------------------
# PythonAnywhere free accounts block standard SMTP (ports 587, 465).
# api.resend.com is allowlisted on PythonAnywhere Free tier!
# Sign up free at https://resend.com and paste your API key:
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Muhammad Hassan Portfolio <onboarding@resend.dev>

# ------------------------------------------------------------
# 2. GMAIL / SMTP CONFIGURATION (For Paid PythonAnywhere or Local Dev)
# ------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=mhassanawan66521@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_DEFAULT_SENDER=mhassanawan66521@gmail.com

# ------------------------------------------------------------
# 3. BREVO API (Optional backup for PythonAnywhere free tier)
# ------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=mhassanawan66521@gmail.com
